{
  "name": "@hraness/cli-update",
  "version": "0.1.0",
  "description": "Automatic updates for installed CLIs, with installation checks and a shared opt-out.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": { "node": ">=22", "bun": ">=1.3.14" },
  "repository": { "type": "git", "url": "https://github.com/hraness/cli-update.git" },
  "homepage": "https://github.com/hraness/cli-update#readme",
  "bugs": { "url": "https://github.com/hraness/cli-update/issues" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/src", "spec", "README.md", "VERIFY.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "test:bun": "bun test --timeout=15000 dist/test",
    "test:package": "node scripts/package-smoke.mjs",
    "check:release": "node scripts/check-release.mjs && node --test scripts/release-notes.test.mjs scripts/publish-release.test.mjs",
    "check:ts": "bun run check:release && bun run build && bun run test && bun run test:bun && bun run test:package",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "check": "bun run check:ts && bun run check:rust"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3"
  }
}
